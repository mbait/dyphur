<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="box_room">

    <!-- Static floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="coll">
          <geometry>
            <box>
              <size>10 10 0.2</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>0</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
      </link>
    </model>

    <!-- A dynamic box sitting on the floor -->
    <model name="box_a">
      <static>false</static>
      <link name="link">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="coll">
          <geometry>
            <box>
              <size>0.4 0.4 0.4</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.0107</ixx><iyy>0.0107</iyy><izz>0.0107</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- A second dynamic box stacked on top -->
    <model name="box_b">
      <static>false</static>
      <link name="link">
        <pose>0 0 2.0 0 0 0</pose>
        <collision name="coll">
          <geometry>
            <box>
              <size>0.4 0.4 0.4</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.0107</ixx><iyy>0.0107</iyy><izz>0.0107</izz>
          </inertia>
        </inertial>
      </link>
    </model>

  </world>
</sdf>
