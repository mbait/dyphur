{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dyphur",
  "version": "0.0.1",
  "description": "GPU-first rigid-body physics framework for robotics simulation.",
  "license": "Apache-2.0",
  "dependencies": [
    "eigen3",
    "spdlog",
    "fmt",
    "pugixml",
    {
      "name": "catch2",
      "version>=": "3.4.0"
    },
    "tracy",
    "sdformat",
    "v-hacd",
    {
      "name": "glfw3",
      "features": ["wayland"]
    },
    {
      "name": "magnum",
      "default-features": false,
      "features": [
        "eglcontext",
        "glfwapplication",
        "windowlesseglapplication",
        "primitives",
        "shaders",
        "anyimageconverter",
        "tgaimageconverter",
        "meshtools"
      ]
    },
    {
      "name": "magnum-plugins",
      "default-features": false,
      "features": ["stbimageconverter"]
    }
  ]
}
